#!/bin/bash

# Firecrawl Unified Management Command
# Purpose: Manage Firecrawl + SearXNG services from anywhere

set -e

# Firecrawl project directory (resolve symlink)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
done
FIREFCRAWL_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Show help information
show_help() {
    cat << HELP
Firecrawl + SearXNG Management Tool

Usage: my-fc <command> [args]

Commands:
    start           Start all services
    stop            Stop all services
    restart         Restart all services
    status          Show service status and health
    health          Check API health (HTTP probe)
    logs [svc] [n]  View logs (default: all, 50 lines)
    ps              List containers
    shell <svc>     Enter container shell (default: api)
    build [svc]     Build images

Examples:
    my-fc start
    my-fc logs api 100
    my-fc shell playwright-service

Access: http://localhost:3002
HELP
}

# Check if Docker is reachable
check_docker() {
    if ! docker info > /dev/null 2>&1; then
        echo -e "${RED}Error: Docker daemon is not reachable.${NC}"
        echo -e "${YELLOW}  Check current context: docker context ls${NC}"
        echo -e "${YELLOW}  Switch context: docker context use <name>${NC}"
        exit 1
    fi
}

# Check api image architecture matches the docker host
check_arch() {
    local host_arch image_arch
    host_arch=$(docker info --format '{{.Architecture}}' 2>/dev/null)
    image_arch=$(docker image inspect firecrawl-api:latest --format '{{.Architecture}}' 2>/dev/null || true)

    if [ -n "$image_arch" ] && [ "$host_arch" != "$image_arch" ]; then
        echo -e "${RED}❌ Architecture mismatch: host=$host_arch, api image=$image_arch${NC}"
        echo -e "${YELLOW}   Rebuild for $host_arch first: my-fc build api${NC}"
        read -p "Continue anyway? (y/n): " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 1
        fi
    fi
}

# Check if in correct directory
check_directory() {
    if [ ! -d "$FIREFCRAWL_DIR" ]; then
        echo -e "${RED}Error: Firecrawl directory does not exist: $FIREFCRAWL_DIR${NC}"
        exit 1
    fi
}

# Start services
cmd_start() {
    check_docker
    check_directory
    check_arch

    cd "$FIREFCRAWL_DIR"

    if [ ! -f ".env" ]; then
        echo -e "${RED}Error: .env file does not exist${NC}"
        exit 1
    fi

    echo "Starting services..."
    docker compose up -d

    echo "Waiting for services to become healthy..."
    for i in $(seq 1 30); do
        sleep 2
        unhealthy=$(docker compose ps --format '{{.Service}} {{.Health}}' 2>/dev/null | grep -c 'unhealthy' || true)
        starting=$(docker compose ps --format '{{.Service}} {{.Health}}' 2>/dev/null | grep -c 'starting' || true)
        if [ "$unhealthy" -eq 0 ] && [ "$starting" -eq 0 ]; then
            break
        fi
    done

    cmd_status
    echo ""
    echo -e "${GREEN}API: http://localhost:3002${NC}"
}

# Stop services
cmd_stop() {
    check_docker
    check_directory

    cd "$FIREFCRAWL_DIR"

    if [ $(docker compose ps -q 2>/dev/null | wc -l | tr -d ' ') -eq 0 ]; then
        echo -e "${YELLOW}No services running${NC}"
        exit 0
    fi

    read -p "Stop all services? (y/n): " -n 1 -r
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled"
        exit 0
    fi

    docker compose down
    echo -e "${GREEN}✅ Stopped${NC}"
}

# Restart services
cmd_restart() {
    check_docker
    check_directory
    check_arch

    cd "$FIREFCRAWL_DIR"

    docker compose down
    echo "Waiting 5s..."
    sleep 5
    docker compose up -d
    echo "Waiting for services to become healthy..."
    for i in $(seq 1 30); do
        sleep 2
        unhealthy=$(docker compose ps --format '{{.Service}} {{.Health}}' 2>/dev/null | grep -c 'unhealthy' || true)
        starting=$(docker compose ps --format '{{.Service}} {{.Health}}' 2>/dev/null | grep -c 'starting' || true)
        if [ "$unhealthy" -eq 0 ] && [ "$starting" -eq 0 ]; then
            break
        fi
    done
    cmd_status
}

# View status
cmd_status() {
    check_docker
    check_directory

    cd "$FIREFCRAWL_DIR"

    if [ $(docker compose ps -q 2>/dev/null | wc -l | tr -d ' ') -eq 0 ]; then
        echo -e "${YELLOW}No services running. Start with: my-fc start${NC}"
        exit 0
    fi

    services=("api" "redis" "rabbitmq" "searxng" "playwright-service" "nuq-postgres")

    for service in "${services[@]}"; do
        container_id=$(docker compose ps -q $service 2>/dev/null || true)

        if [ -n "$container_id" ]; then
            status=$(docker inspect -f '{{.State.Status}}' $container_id 2>/dev/null || echo "unknown")

            if [ "$status" == "running" ]; then
                health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' $container_id 2>/dev/null || echo "none")

                if [ "$health" == "healthy" ]; then
                    echo -e "${GREEN}✅ $service${NC}"
                elif [ "$health" == "unhealthy" ]; then
                    echo -e "${RED}❌ $service (unhealthy)${NC}"
                elif [ "$health" == "starting" ]; then
                    echo -e "${YELLOW}⏳ $service (starting)${NC}"
                else
                    echo -e "${GREEN}✅ $service${NC}"
                fi
            else
                echo -e "${RED}❌ $service (stopped)${NC}"
            fi
        else
            echo -e "${RED}❌ $service (not found)${NC}"
        fi
    done
}

# View logs
cmd_logs() {
    SERVICE=${1:-}
    LINES=${2:-50}

    check_docker
    check_directory

    cd "$FIREFCRAWL_DIR"

    if [ -z "$SERVICE" ]; then
        echo -e "${BLUE}Viewing all service logs (last $LINES lines)...${NC}"
        echo ""
        docker compose logs --tail $LINES
    else
        echo -e "${BLUE}Viewing $SERVICE service logs (last $LINES lines)...${NC}"
        echo ""
        docker compose logs --tail $LINES $SERVICE
    fi

    echo ""
    echo -e "${YELLOW}Tip: docker compose logs -f $SERVICE${NC}"
    echo ""
}

# View container list
cmd_ps() {
    check_docker
    check_directory

    cd "$FIREFCRAWL_DIR"

    docker compose ps
}

# Enter container shell
cmd_shell() {
    SERVICE=${1:-api}

    check_docker
    check_directory

    cd "$FIREFCRAWL_DIR"

    if ! docker compose ps -q $SERVICE > /dev/null 2>&1; then
        echo -e "${RED}Error: Service $SERVICE does not exist or is not running${NC}"
        exit 1
    fi

    docker compose exec $SERVICE /bin/sh
}

# Build Docker images
cmd_build() {
    SERVICE=${1:-}

    check_docker
    check_directory

    cd "$FIREFCRAWL_DIR"

    if [ -n "$SERVICE" ]; then
        echo "Building: $SERVICE"
        docker compose build $SERVICE
    else
        echo "Building all images..."
        docker compose build
    fi

    echo -e "${GREEN}✅ Done${NC}"
}

# Check API health via HTTP
cmd_health() {
    local API_URL="http://localhost:3002"
    
    echo "Checking API health..."
    echo ""
    
    # 1. Basic connectivity
    echo -n "API endpoint: "
    if response=$(curl -s --max-time 5 "$API_URL/" 2>/dev/null); then
        if echo "$response" | grep -q "Firecrawl"; then
            echo -e "${GREEN}✅ Responding${NC}"
        else
            echo -e "${YELLOW}⚠️  Unexpected response${NC}"
            echo "$response" | head -c 200
        fi
    else
        echo -e "${RED}❌ Not reachable${NC}"
        echo ""
        echo "Troubleshooting:"
        echo "  1. Check if services are running: my-fc status"
        echo "  2. Check API logs: my-fc logs api 100"
        return 1
    fi
    
    # 2. Scrape test (lightweight)
    echo -n "Scrape test: "
    local scrape_result
    scrape_result=$(curl -s --max-time 30 -X POST "$API_URL/v2/scrape" \
        -H "Content-Type: application/json" \
        -d '{"url": "https://example.com"}' 2>/dev/null)
    
    if echo "$scrape_result" | grep -q '"success":true'; then
        echo -e "${GREEN}✅ Working${NC}"
    elif echo "$scrape_result" | grep -q '"success"'; then
        echo -e "${RED}❌ Failed${NC}"
        echo "$scrape_result" | head -c 300
    else
        echo -e "${YELLOW}⚠️  Unexpected response${NC}"
        echo "$scrape_result" | head -c 200
    fi
    
    echo ""
    echo -e "${GREEN}Health check complete${NC}"
}

# Main command
case "${1:-}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    health)
        cmd_health
        ;;
    logs)
        cmd_logs "${2:-}" "${3:-50}"
        ;;
    ps)
        cmd_ps
        ;;
    shell)
        cmd_shell "${2:-api}"
        ;;
    build)
        cmd_build "${2:-}"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        if [ -z "${1:-}" ]; then
            show_help
        else
            echo -e "${RED}Error: Unknown command: ${1}${NC}"
            echo ""
            echo "Run 'my-fc help' to see available commands"
            exit 1
        fi
        ;;
esac
