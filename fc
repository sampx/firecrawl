#!/bin/bash

# Firecrawl Unified Management Command
# Purpose: Manage Firecrawl + SearXNG services from anywhere

set -e

# Firecrawl project directory
FIREFCRAWL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Show help information
show_help() {
    cat << 'HELP'
Firecrawl + SearXNG Management Tool

Usage:
    firecrawl <command> [options]

Commands:
    start       Start all services
    stop        Stop all services
    restart     Restart all services
    status      View service status (health check, resource usage)
    logs        View service logs
    test        Test API functionality
    ps          View container list
    shell       Enter container shell
    update      Update service images
    backup      Backup configuration files
    help        Show this help message

Log Options:
    firecrawl logs              View all service logs (last 50 lines)
    firecrawl logs api          View API service logs
    firecrawl logs searxng      View SearXNG service logs
    firecrawl logs api 100      View specified number of log lines

Shell Options:
    firecrawl shell api         Enter API container
    firecrawl shell searxng     Enter SearXNG container

Test Options:
    firecrawl test search       Test search functionality
    firecrawl test scrape       Test scrape functionality

Examples:
    # Start services
    firecrawl start

    # View status
    firecrawl status

    # View API logs
    firecrawl logs api 100

    # Test search functionality
    firecrawl test search

    # Enter API container
    firecrawl shell api

Access URLs:
    Firecrawl API:    http://localhost:3002
    RabbitMQ Management: http://localhost:15672 (guest/guest)

Configuration:
    Project Directory: $FIREFCRAWL_DIR
    Environment File:  $FIREFCRAWL_DIR/.env
    SearXNG Config:    $FIREFCRAWL_DIR/searxng/settings.yml

Documentation:
    Quick Start:  $FIREFCRAWL_DIR/QUICK_START.md
    Full Guide:   $FIREFCRAWL_DIR/SEARXNG_INTEGRATION.md
    Scripts:      $FIREFCRAWL_DIR/scripts/README.md
HELP
}

# Check if Docker is running
check_docker() {
    if ! docker info > /dev/null 2>&1; then
        echo -e "${RED}Error: Docker is not running. Please start Docker first.${NC}"
        exit 1
    fi
}

# Check if in correct directory
check_directory() {
    if [ ! -d "$FIREFCRAWL_DIR" ]; then
        echo -e "${RED}Error: Firecrawl directory does not exist: $FIREFCRAWL_DIR${NC}"
        exit 1
    fi
}

# Start services
cmd_start() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}Starting Firecrawl + SearXNG Services${NC}"
    echo -e "${BLUE}================================$NC}"
    echo ""
    
    check_docker
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    if [ ! -f ".env" ]; then
        echo -e "${RED}Error: .env file does not exist${NC}"
        exit 1
    fi
    
    echo "Starting services..."
    docker-compose up -d
    
    echo ""
    echo "Waiting for services to start (30 seconds)..."
    sleep 30
    
    echo ""
    cmd_status
    
    echo ""
    echo -e "${GREEN}✅ Services started successfully${NC}"
    echo ""
    echo -e "${YELLOW}Access URLs:${NC}"
    echo "  - Firecrawl API: http://localhost:3002"
    echo "  - RabbitMQ Management: http://localhost:15672"
    echo ""
}

# Stop services
cmd_stop() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}Stopping Firecrawl + SearXNG Services${NC}"
    echo -e "${BLUE}================================${NC}"
    echo ""
    
    check_docker
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    if [ $(docker-compose ps -q 2>/dev/null | wc -l | tr -d ' ') -eq 0 ]; then
        echo -e "${YELLOW}No services are running${NC}"
        exit 0
    fi
    
    echo "Currently running services:"
    docker-compose ps
    
    echo ""
    read -p "Confirm stopping all services? (y/n): " -n 1 -r
    echo ""
    
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled"
        exit 0
    fi
    
    echo ""
    echo "Stopping services..."
    docker-compose down
    
    echo ""
    echo -e "${GREEN}✅ Services stopped${NC}"
    echo ""
}

# Restart services
cmd_restart() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}Restarting Firecrawl + SearXNG Services${NC}"
    echo -e "${BLUE}================================${NC}"
    echo ""
    
    check_docker
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    echo "Stopping services..."
    docker-compose down
    
    echo ""
    echo "Waiting 5 seconds..."
    sleep 5
    
    echo ""
    echo "Starting services..."
    docker-compose up -d
    
    echo ""
    echo "Waiting for services to start (30 seconds)..."
    sleep 30
    
    echo ""
    cmd_status
    
    echo ""
    echo -e "${GREEN}✅ Services restarted successfully${NC}"
    echo ""
}

# View status
cmd_status() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}Firecrawl + SearXNG Service Status${NC}"
    echo -e "${BLUE}================================${NC}"
    echo ""
    
    check_docker
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    if [ $(docker-compose ps -q 2>/dev/null | wc -l | tr -d ' ') -eq 0 ]; then
        echo -e "${YELLOW}⚠️  No services are running${NC}"
        echo ""
        echo "Start services: firecrawl start"
        exit 0
    fi
    
    echo -e "${GREEN}Service List:${NC}"
    echo ""
    docker-compose ps
    
    echo ""
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}Health Status Check${NC}"
    echo -e "${BLUE}================================${NC}"
    
    services=("api" "redis" "rabbitmq" "searxng" "searxng-redis" "playwright-service" "nuq-postgres")
    
    for service in "${services[@]}"; do
        container_id=$(docker-compose ps -q $service 2>/dev/null || true)
        
        if [ -n "$container_id" ]; then
            status=$(docker inspect -f '{{.State.Status}}' $container_id 2>/dev/null || echo "unknown")
            
            if [ "$status" == "running" ]; then
                health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' $container_id 2>/dev/null || echo "none")
                
                if [ "$health" == "healthy" ]; then
                    echo -e "${GREEN}✅ $service: Running (Healthy)${NC}"
                elif [ "$health" == "unhealthy" ]; then
                    echo -e "${RED}❌ $service: Running (Unhealthy)${NC}"
                elif [ "$health" == "starting" ]; then
                    echo -e "${YELLOW}⏳ $service: Running (Starting)${NC}"
                else
                    echo -e "${GREEN}✅ $service: Running${NC}"
                fi
            else
                echo -e "${RED}❌ $service: Stopped${NC}"
            fi
        else
            echo -e "${RED}❌ $service: Not found${NC}"
        fi
    done
    
    echo ""
    echo -e "${BLUE}Network Connectivity Check:${NC}"
    network_containers=$(docker network inspect firecrawl_backend --format '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null || echo "")
    if [ -n "$network_containers" ]; then
        echo -e "${GREEN}✅ All containers on network: firecrawl_backend${NC}"
    else
        echo -e "${RED}❌ Network firecrawl_backend does not exist or has no containers${NC}"
    fi
    
    echo ""
    echo -e "${BLUE}Resource Usage:${NC}"
    docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}" 2>/dev/null | head -8
    echo ""
}

# View logs
cmd_logs() {
    SERVICE=${1:-}
    LINES=${2:-50}
    
    check_docker
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    if [ -z "$SERVICE" ]; then
        echo -e "${BLUE}Viewing all service logs (last $LINES lines)...${NC}"
        echo ""
        docker-compose logs --tail $LINES
    else
        echo -e "${BLUE}Viewing $SERVICE service logs (last $LINES lines)...${NC}"
        echo ""
        docker-compose logs --tail $LINES $SERVICE
    fi
    
    echo ""
    echo -e "${YELLOW}Tip: Use 'docker-compose logs -f $SERVICE' to follow logs in real-time${NC}"
    echo ""
}

# Test functionality
cmd_test() {
    TEST_TYPE=${1:-search}
    
    case $TEST_TYPE in
        search)
            echo -e "${BLUE}Testing search functionality...${NC}"
            echo ""
            curl -X POST http://localhost:3002/v1/search \
              -H "Content-Type: application/json" \
              -d '{"query": "firecrawl web scraping", "limit": 3}' 2>/dev/null | jq '.' 2>/dev/null || \
            curl -X POST http://localhost:3002/v1/search \
              -H "Content-Type: application/json" \
              -d '{"query": "firecrawl web scraping", "limit": 3}'
            echo ""
            ;;
        scrape)
            echo -e "${BLUE}Testing scrape functionality...${NC}"
            echo ""
            curl -X POST http://localhost:3002/v1/scrape \
              -H "Content-Type: application/json" \
              -d '{"url": "https://example.com"}' 2>/dev/null | jq '.' 2>/dev/null || \
            curl -X POST http://localhost:3002/v1/scrape \
              -H "Content-Type: application/json" \
              -d '{"url": "https://example.com"}'
            echo ""
            ;;
        *)
            echo -e "${RED}Error: Unknown test type: $TEST_TYPE${NC}"
            echo "Available tests: search, scrape"
            exit 1
            ;;
    esac
}

# View container list
cmd_ps() {
    check_docker
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    echo -e "${BLUE}Container List:${NC}"
    echo ""
    docker-compose ps
    echo ""
}

# Enter container shell
cmd_shell() {
    SERVICE=${1:-api}
    
    check_docker
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    echo -e "${BLUE}Entering $SERVICE container...${NC}"
    echo ""
    
    if ! docker-compose ps -q $SERVICE > /dev/null 2>&1; then
        echo -e "${RED}Error: Service $SERVICE does not exist or is not running${NC}"
        exit 1
    fi
    
    docker-compose exec $SERVICE /bin/sh
}

# Update service images
cmd_update() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}Updating Firecrawl Service Images${NC}"
    echo -e "${BLUE}================================${NC}"
    echo ""
    
    check_docker
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    echo "Pulling latest images..."
    docker-compose pull
    
    echo ""
    echo "Restarting services..."
    docker-compose up -d
    
    echo ""
    echo -e "${GREEN}✅ Update completed${NC}"
    echo ""
}

# Backup configuration files
cmd_backup() {
    BACKUP_DIR="$FIREFCRAWL_DIR/backups"
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    BACKUP_FILE="firecrawl-config-backup-$TIMESTAMP.tar.gz"
    
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}Backing Up Configuration Files${NC}"
    echo -e "${BLUE}================================${NC}"
    echo ""
    
    check_directory
    
    cd "$FIREFCRAWL_DIR"
    
    mkdir -p "$BACKUP_DIR"
    
    echo "Creating backup..."
    tar -czf "$BACKUP_DIR/$BACKUP_FILE" \
        .env \
        searxng/settings.yml \
        docker-compose.override.yml 2>/dev/null || true
    
    echo ""
    echo -e "${GREEN}✅ Backup completed${NC}"
    echo "Backup file: $BACKUP_DIR/$BACKUP_FILE"
    echo ""
    
    echo "Existing backups:"
    ls -lh "$BACKUP_DIR"/*.tar.gz 2>/dev/null || echo "  (None)"
    echo ""
}

# Main command
case "${1:-}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs "${2:-}" "${3:-50}"
        ;;
    test)
        cmd_test "${2:-search}"
        ;;
    ps)
        cmd_ps
        ;;
    shell)
        cmd_shell "${2:-api}"
        ;;
    update)
        cmd_update
        ;;
    backup)
        cmd_backup
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        if [ -z "${1:-}" ]; then
            show_help
        else
            echo -e "${RED}Error: Unknown command: ${1}${NC}"
            echo ""
            echo "Run 'firecrawl help' to see available commands"
            exit 1
        fi
        ;;
esac
